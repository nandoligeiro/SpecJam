{
  "schema": 2,
  "specjam_version": "0.2.0",
  "default_graph": "delivery",
  "trail_directory": "runs",
  "aggregation": "opt-in",
  "runtime_discovery": ["AGENTS.md", "CLAUDE.md", "GEMINI.md", "COPILOT.md"],
  "meta_harness": {
    "default_harness": "default",
    "session_strategy": "new_per_increment",
    "max_retries": 2
  },
  "memory": {
    "backend": "sqlite",
    "path": "memory/specjam.db",
    "retrieval": "hybrid",
    "intervention": "selective",
    "top_k": 3,
    "min_score": 0.55,
    "write_policy": "accepted_evidence_only"
  },
  "skill_providers": {
    "workspace": {"type": "filesystem", "path": "skills"},
    "ligeiro-mindware": {
      "type": "git",
      "repository": "https://github.com/nandoligeiro/ligeiro-mindware",
      "path": "skills"
    }
  }
}
