{
  "schema": 2,
  "specjam_version": "0.2.0",
  "default_graph": "delivery",
  "trail_directory": "runs",
  "aggregation": "opt-in",
  "runtime_discovery": ["AGENTS.md", "CLAUDE.md", "GEMINI.md", "COPILOT.md"],
  "meta_harness": {
    "default_harness": "default",
    "session_strategy": "new_per_increment",
    "max_retries": 2
  },
  "memory": {
    "backend": "auto",
    "vector_backends": ["sqlite-vec", "exact"],
    "path": "memory/specjam.db",
    "embedding": {
      "provider": "fastembed",
      "model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
      "dimensions": "auto",
      "network_during_execution": false
    },
    "retrieval": "hybrid",
    "intervention": "selective",
    "top_k": 3,
    "min_score": 0.55,
    "write_policy": "accepted_evidence_only",
    "calibration": {
      "top_k_candidates": [1, 2, 3, 5],
      "min_score_candidates": [0.4, 0.5, 0.55, 0.6, 0.7, 0.8]
    }
  },
  "skill_providers": {
    "workspace": {"type": "filesystem", "path": "skills"},
    "ligeiro-mindware": {
      "type": "git",
      "repository": "https://github.com/nandoligeiro/ligeiro-mindware",
      "path": "skills"
    }
  }
}
