{
  "id": "bugfix",
  "version": "0.1.0",
  "description": "Evidence-first bug flow: assess, reproduce, diagnose, fix, and verify.",
  "start_stage": "intake",
  "terminal_stages": ["complete"],
  "nodes": [
    {"id": "intake", "agent": "specjam.orchestrator", "transitions": [{"to": "assess"}]},
    {"id": "assess", "agent": "specjam.bug-assessor", "required_artifacts": ["report.md"], "transitions": [{"to": "reproduce"}], "block_implementation": true},
    {"id": "reproduce", "agent": "specjam.investigator", "required_artifacts": ["reproduction.md"], "transitions": [{"to": "diagnose"}], "block_implementation": true},
    {"id": "diagnose", "agent": "specjam.diagnostician", "required_artifacts": ["diagnosis.md"], "reviewers": ["domain", "security", "observability", "tests"], "writer": "specjam.synthesis", "transitions": [{"to": "fix"}], "block_implementation": true},
    {"id": "fix", "agent": "specjam.implementer", "required_artifacts": ["fix-plan.md", "implementation.md"], "transitions": [{"to": "verify"}]},
    {"id": "verify", "agent": "specjam.verifier", "required_artifacts": ["verification.md"], "transitions": [{"to": "complete"}]},
    {"id": "complete", "agent": "specjam.orchestrator"}
  ]
}

