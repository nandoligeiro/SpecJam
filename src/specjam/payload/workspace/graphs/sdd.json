{
  "id": "sdd",
  "version": "0.1.0",
  "description": "Software Design Document flow for architecture-sensitive decisions.",
  "start_stage": "intake",
  "terminal_stages": ["complete"],
  "nodes": [
    {"id": "intake", "agent": "specjam.orchestrator", "transitions": [{"to": "context"}]},
    {"id": "context", "agent": "specjam.context", "required_artifacts": ["context.md"], "transitions": [{"to": "constraints"}], "block_implementation": true, "blocking_reason": "Implementation is blocked until the design context is durable."},
    {"id": "constraints", "agent": "specjam.architect", "required_artifacts": ["constraints.md"], "transitions": [{"to": "design"}], "block_implementation": true},
    {"id": "design", "agent": "specjam.architect", "required_artifacts": ["sdd.md"], "transitions": [{"to": "review"}], "block_implementation": true},
    {"id": "review", "agent": "specjam.architect", "required_artifacts": ["sdd-review.md"], "reviewers": ["architecture", "security", "observability", "tests"], "writer": "specjam.synthesis", "transitions": [{"to": "decision"}], "block_implementation": true, "blocking_reason": "Implementation is blocked until the SDD review is complete."},
    {"id": "decision", "agent": "specjam.synthesis", "required_artifacts": ["sdd-decision.md"], "transitions": [{"to": "handoff"}], "block_implementation": true},
    {"id": "handoff", "agent": "specjam.orchestrator", "required_artifacts": ["sdd-handoff.md"], "transitions": [{"to": "complete"}]},
    {"id": "complete", "agent": "specjam.orchestrator"}
  ]
}
