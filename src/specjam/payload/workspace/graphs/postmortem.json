{
  "id": "postmortem",
  "version": "0.1.0",
  "description": "Blameless postmortem flow for turning incidents into learning and actions.",
  "start_stage": "intake",
  "terminal_stages": ["complete"],
  "nodes": [
    {"id": "intake", "agent": "specjam.orchestrator", "transitions": [{"to": "incident"}]},
    {"id": "incident", "agent": "specjam.postmortem", "required_artifacts": ["incident.md"], "transitions": [{"to": "timeline"}], "block_implementation": true},
    {"id": "timeline", "agent": "specjam.investigator", "required_artifacts": ["timeline.md"], "transitions": [{"to": "causes"}], "block_implementation": true},
    {"id": "causes", "agent": "specjam.postmortem", "required_artifacts": ["causes.md"], "reviewers": ["domain", "architecture", "security", "observability", "tests"], "writer": "specjam.synthesis", "transitions": [{"to": "actions"}], "block_implementation": true},
    {"id": "actions", "agent": "specjam.postmortem", "required_artifacts": ["actions.md"], "transitions": [{"to": "postmortem"}], "block_implementation": true},
    {"id": "postmortem", "agent": "specjam.synthesis", "required_artifacts": ["postmortem.md"], "transitions": [{"to": "review"}], "block_implementation": true},
    {"id": "review", "agent": "specjam.orchestrator", "required_artifacts": ["postmortem-review.md"], "transitions": [{"to": "complete"}]},
    {"id": "complete", "agent": "specjam.orchestrator"}
  ]
}
